WEB_PORT= 9005
PHP_MYADMIN_PORT=8085
MYSQL_ROOT_PASSWORD= "catsAreBros"
DB_NAME= "database-name"
DB_USER= "name"
DB_PASSWORD= "password"

# Tailscale (tailscale service). Get TS_AUTHKEY from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
# Optional: e.g. --advertise-tags=tag:container when using an OAuth client secret as TS_AUTHKEY
TS_EXTRA_ARGS=

# Tailscale: machine hostname (MagicDNS first label) and your tailnet DNS suffix.
TAILSCALE_MAGICDNS_HOSTNAME=rivedge-site
TAILNET_DNS_SUFFIX=ferret-boa.ts.net
# Optional: omit this line so Compose defaults WordPress to https://$TAILSCALE_MAGICDNS_HOSTNAME.$TAILNET_DNS_SUFFIX (correct scheme for Serve).
# For localhost-only dev (no redirect to MagicDNS), add: WORDPRESS_PUBLIC_URL=
# Optional: set to 1 to enable FORCE_SSL_ADMIN (omit for localhost admin login when public URL is https).
# WORDPRESS_FORCE_SSL_ADMIN=
